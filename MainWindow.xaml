<Window x:Class="TrackTelemetryViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrackTelemetryViewer"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PitWall" Width="1440" Height="920"
        MinWidth="1080" MinHeight="700"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#11171D" Foreground="#E8EDF2"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="12"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DarkComboBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="PanelBrush" Color="#1A222B"/>
        <SolidColorBrush x:Key="RaisedBrush" Color="#202A35"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A0AD"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#39C3D8"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8EDF2"/>
            <Setter Property="Background" Value="#293542"/>
            <Setter Property="BorderBrush" Value="#394857"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#344554"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8EDF2"/>
            <Setter Property="Background" Value="#11171D"/>
            <Setter Property="BorderBrush" Value="#394857"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="#E8EDF2"/>
        </Style>
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#D5DCE3"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="3,4"/>
            <Setter Property="Foreground" Value="#D5DCE3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="Expander" Grid.Row="0" Width="14" Height="18"
                                          Focusable="False" ClickMode="Press" Padding="0"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                <Path x:Name="ExpanderArrow" Data="M 0,0 L 5,4.5 L 0,9 Z"
                                      Fill="#82909E" HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Path.RenderTransform>
                                </Path>
                            </ToggleButton>
                            <Border x:Name="HeaderBorder" Grid.Column="1" Padding="{TemplateBinding Padding}"
                                    Background="Transparent" CornerRadius="4">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderArrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#293945"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBorder" Property="Background" Value="#222D37"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C9D2DB"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#171E25" BorderBrush="#28323D" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/PitwallLogo.png" Width="38" Height="38" Margin="0,0,11,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Pit Wall" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0"/>
                    <Button x:Name="UpdateButton" Content="Update available" Click="Update_Click"
                            Visibility="Collapsed" Margin="14,0,0,0" Padding="10,3" FontSize="11"
                            Background="#1F4D36" BorderBrush="#2F7A54"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionCountText" Text="No sessions loaded"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="Open data folder" Click="OpenFolder_Click"/>
                    <Button Content="Import…" Click="Import_Click" Margin="8,0,0,0"
                            ToolTip="Import PitWall packages into the data folder"/>
                    <Button Content="⚙" Click="Settings_Click" ToolTip="Settings"
                            FontSize="17" Padding="9,3" Margin="8,0,0,0"
                            AutomationProperties.Name="Settings"/>
                    <Button Content="×" Click="Close_Click" ToolTip="Close"
                            FontSize="20" Padding="9,1" Margin="8,0,0,0"
                            AutomationProperties.Name="Close"
                            Background="#34272B" BorderBrush="#54373D"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="338" MinWidth="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#171E25" BorderBrush="#28323D" BorderThickness="0,0,1,0">
                <Grid Margin="16,16,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="3,0,0,13">
                        <TextBlock Text="SESSION LIBRARY" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="DataFolderText" Text="Choose a folder containing session JSON files"
                                   FontSize="10" Foreground="#798693" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TreeView x:Name="SessionTree" Grid.Row="1"
                              SelectedItemChanged="SessionTree_SelectedItemChanged"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="#394857"
                          ShowsPreview="False" ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWE"/>

            <Grid Grid.Column="2">
                <Grid x:Name="DataViewPanel" Margin="19,15,19,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,2,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TrackTitleText" Text="Select a session"
                                           FontSize="21" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="REFERENCE LAP" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="13,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SESSION · LAP" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="PrimaryLapTypeText" FontSize="9" FontWeight="Bold"
                                                   HorizontalAlignment="Right" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="PrimaryLapText" Text="—" FontSize="10"
                                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock x:Name="PrimaryLapDetailsText" FontSize="9"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="13,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="REFERENCE · LAP" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}"/>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock x:Name="ReferenceLapTypeText" FontSize="9" FontWeight="Bold"
                                                   HorizontalAlignment="Right" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="ReferenceLapText" Text="—" FontSize="10"
                                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <TextBlock x:Name="ReferenceLapDetailsText" FontSize="9"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="13,10">
                            <StackPanel>
                                <TextBlock Text="LAP DELTA · A − B" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="LapDeltaText" Text="—" FontSize="19"
                                               FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="13,10">
                            <StackPanel>
                                <TextBlock Text="DISTANCE AT CURSOR" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="CursorDistanceText" Text="—" FontSize="19"
                                               FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.78*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.22*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8"
                                ClipToBounds="True">
                            <local:TrackMap x:Name="TrackMapView"/>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChartListPanel"/>
                        </ScrollViewer>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                                   Text="Move over any chart to inspect the same distance on the GPS trace and other plots."
                                   FontSize="10" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Bottom" Margin="0,8,0,0"/>
                    </Grid>
                </Grid>
                <Grid x:Name="TrackOverviewPanel" Visibility="Collapsed" Margin="19,15,19,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="2,0,2,14">
                        <TextBlock x:Name="OverviewTrackTitle" Text="Track overview"
                                   FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock x:Name="OverviewTrackSubtitle" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                                CornerRadius="10" ClipToBounds="True">
                            <local:TrackMap x:Name="TrackOverviewMap" Enable3DOverview="True"/>
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TRACK INTELLIGENCE" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}" Margin="3,3,0,10"/>
                            <UniformGrid Columns="2" Rows="2">
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="8"
                                            Padding="13" Margin="0,0,6,6">
                                    <StackPanel>
                                            <TextBlock Text="VEHICLES" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="OverviewVehicleCount" Text="—"
                                                       FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="8"
                                            Padding="13" Margin="6,0,0,6">
                                    <StackPanel>
                                            <TextBlock Text="SESSIONS" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="OverviewSessionCount" Text="—"
                                                       FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="8"
                                            Padding="13" Margin="0,6,6,0">
                                    <StackPanel>
                                            <TextBlock Text="LAPS" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="OverviewLapCount" Text="Counting…"
                                                       FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="8"
                                            Padding="13" Margin="6,6,0,0">
                                    <StackPanel>
                                            <TextBlock Text="TRACK LENGTH" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                            <TextBlock x:Name="OverviewTrackLength" Text="—"
                                                       FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <TextBlock Text="CARS &amp; DRIVERS" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource MutedBrush}" Margin="3,16,0,8"/>
                            <ListView x:Name="TrackCarStatsList" Background="{StaticResource PanelBrush}"
                                      BorderThickness="0" Foreground="#E8EDF2"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#2B3641" BorderThickness="0,0,0,1"
                                                Padding="8,7">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DriverName}" FontSize="12"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Laps, StringFormat={}{0} laps}"
                                                               FontSize="10" Foreground="{StaticResource MutedBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Cars}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="8,3,0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="160"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding VehicleName}"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource AccentBrush}"/>
                                                                    <TextBlock FontSize="9"
                                                                               Foreground="{StaticResource MutedBrush}">
                                                                        <Run Text="{Binding Sessions, Mode=OneWay}"/><Run Text=" sessions · "/><Run Text="{Binding Laps, Mode=OneWay}"/><Run Text=" laps"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1"
                                                                            VerticalAlignment="Center"
                                                                            HorizontalAlignment="Stretch">
                                                                    <Button Content="{Binding FastestLapLabel}"
                                                                            Tag="{Binding FastestLap}"
                                                                            ToolTip="{Binding FastestLapToolTip}"
                                                                            Click="TrackLapLink_Click"
                                                                            IsEnabled="{Binding HasFastestLap}"
                                                                            Foreground="LimeGreen"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Padding="0"
                                                                            FontSize="9"
                                                                            HorizontalContentAlignment="Right"/>
                                                                    <Button Content="{Binding OptimalLapLabel}"
                                                                            Tag="{Binding OptimalLap}"
                                                                            ToolTip="{Binding OptimalLapToolTip}"
                                                                            Click="TrackLapLink_Click"
                                                                            IsEnabled="{Binding HasOptimalLap}"
                                                                            Foreground="MediumPurple"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Padding="0"
                                                                            FontSize="9"
                                                                            HorizontalContentAlignment="Right"
                                                                            Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="OverviewStatusText" Grid.Row="2" Text="Select a track or car to view its overview."
                               Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="3,10,0,0"/>
                </Grid>
                <Grid x:Name="LoadingIndicator" Panel.ZIndex="10" Visibility="Collapsed"
                      IsHitTestVisible="False" Background="#9911171D">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#202A35" BorderBrush="#394857" BorderThickness="1"
                            CornerRadius="12" Padding="34,28" MinWidth="420">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="LOADING TELEMETRY" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LoadingDetailText" FontSize="15"
                                       Foreground="#E8EDF2" MaxWidth="560"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                       Margin="0,12,0,18"/>
                            <ProgressBar Width="350" Height="12" IsIndeterminate="True"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="#293542" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#171E25" BorderBrush="#28323D" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="10"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
