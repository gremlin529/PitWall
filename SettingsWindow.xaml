<Window x:Class="TrackTelemetryViewer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Track Telemetry Settings" Width="760" Height="590"
        MinWidth="620" MinHeight="450" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#11171D" Foreground="#E8EDF2" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DarkComboBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="#E8EDF2"/>
                <Setter Property="Background" Value="#293542"/>
                <Setter Property="BorderBrush" Value="#394857"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#344554"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="#E8EDF2"/>
                <Setter Property="Background" Value="#11171D"/>
                <Setter Property="BorderBrush" Value="#394857"/>
                <Setter Property="Padding" Value="9,7"/>
                <Setter Property="CaretBrush" Value="#E8EDF2"/>
            </Style>
            <Style TargetType="ListView">
                <Setter Property="Background" Value="#1A222B"/>
                <Setter Property="Foreground" Value="#E8EDF2"/>
                <Setter Property="BorderBrush" Value="#394857"/>
            </Style>
            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Foreground" Value="#94A0AD"/>
                <Setter Property="Background" Value="#202A35"/>
                <Setter Property="BorderBrush" Value="#394857"/>
                <Setter Property="Padding" Value="8,6"/>
            </Style>
            <Style TargetType="ListViewItem">
                <Setter Property="Foreground" Value="#E8EDF2"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="RowBorder" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <GridViewRowPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="#222D37"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="#293945"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="#1A222B"/>
                <Setter Property="Foreground" Value="#E8EDF2"/>
                <Setter Property="BorderBrush" Value="#394857"/>
            </Style>
            <Style TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="#E8EDF2"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="RowBorder" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="#222D37"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="#11171D"/>
                <Setter Property="BorderBrush" Value="#394857"/>
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="#94A0AD"/>
                <Setter Property="Background" Value="#202A35"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="#394857" BorderThickness="1,1,1,0"
                                    CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="#293542"/>
                                    <Setter Property="Foreground" Value="#E8EDF2"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#E8EDF2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="SETTINGS" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Choose distance units, organize cars, and rename or combine track layouts."
                       Foreground="#94A0AD" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Distance units" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <ComboBox x:Name="DistanceUnitCombo" Grid.Column="1" SelectedIndex="0">
                <ComboBoxItem Content="Metric (km, m)"/>
                <ComboBoxItem Content="Imperial (mi, ft)"/>
            </ComboBox>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Cars">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CAR ALIASES" FontSize="10" FontWeight="Bold"
                                       Foreground="#94A0AD"/>
                            <TextBlock Text="Give each data alias a library name; use the same name to combine cars."
                                       Foreground="#94A0AD" FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBox x:Name="NewVehicleNameBox" Width="190" VerticalContentAlignment="Center"
                                     ToolTip="Name for a new vehicle choice"/>
                            <Button Content="Add vehicle" Click="AddVehicle_Click" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="AliasList" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Alias from data" Width="270"
                                                DisplayMemberBinding="{Binding Alias}"/>
                                <GridViewColumn Header="Car name in library" Width="370">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox IsEditable="True" IsTextSearchEnabled="True"
                                                      ItemsSource="{Binding DataContext.VehicleNames,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Text="{Binding VehicleName, UpdateSourceTrigger=PropertyChanged}"
                                                      MinWidth="340"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <StackPanel Grid.Row="2" Margin="0,12,0,6">
                        <TextBlock Text="VEHICLES SHOWN IN THE LIBRARY" FontSize="10" FontWeight="Bold"
                                   Foreground="#94A0AD"/>
                        <TextBlock Text="Use the visibility icon to hide or restore a vehicle."
                                   Foreground="#94A0AD" FontSize="10" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="VehicleNameList" Grid.Row="3"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Tag="{Binding}"
                                            Click="ToggleVehicleVisibility_Click"
                                            Padding="8,4" Margin="8,0,0,0"
                                            ToolTip="{Binding VisibilityToolTip}">
                                        <TextBlock Text="{Binding VisibilityGlyph}" FontSize="16"
                                                   Foreground="#94A0AD"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="Tracks">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="TRACK AND LAYOUT ALIASES" FontSize="10" FontWeight="Bold"
                                   Foreground="#94A0AD"/>
                        <TextBlock Text="Edit the library name or give different data aliases the same name to combine layouts."
                                   Foreground="#94A0AD" FontSize="10" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ListView x:Name="TrackAliasList" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Track/layout from data" Width="330"
                                                DisplayMemberBinding="{Binding Alias}"/>
                                <GridViewColumn Header="Track/layout name in library" Width="360">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     MinWidth="330"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90"/>
            <Button Content="Save settings" IsDefault="True" Click="Save_Click"
                    MinWidth="120" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
