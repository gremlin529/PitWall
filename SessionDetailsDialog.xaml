<Window x:Class="TrackTelemetryViewer.SessionDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session details" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#11171D" Foreground="#E8EDF2" FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DarkComboBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="#E8EDF2"/>
                <Setter Property="Background" Value="#293542"/>
                <Setter Property="BorderBrush" Value="#394857"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="MinWidth" Value="80"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#344554"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="#E8EDF2"/>
                <Setter Property="Background" Value="#11171D"/>
                <Setter Property="BorderBrush" Value="#394857"/>
                <Setter Property="Padding" Value="9,7"/>
                <Setter Property="CaretBrush" Value="#E8EDF2"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="#94A0AD"/>
                <Setter Property="Margin" Value="0,10,0,4"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="HeaderText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="Vehicle / car" Style="{StaticResource FieldLabel}" Margin="0,14,0,4"/>
        <ComboBox x:Name="VehicleNameCombo" IsEditable="True" IsTextSearchEnabled="True"/>
        <TextBlock Text="Driver" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="DriverNameBox"/>
        <TextBlock Text="Track / layout" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="SessionTrackCombo" SelectedValuePath="Value">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Track condition" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="TrackConditionCombo" IsEditable="True">
            <ComboBoxItem Content="DRY"/>
            <ComboBoxItem Content="WET"/>
            <ComboBoxItem Content="UNKNOWN"/>
        </ComboBox>
        <TextBlock Text="Session type" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="RaceTypeBox"/>
        <TextBlock x:Name="SessionAliasText" FontSize="10" TextWrapping="Wrap"
                   Foreground="#94A0AD" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" Click="Save_Click" IsDefault="True"/>
            <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
