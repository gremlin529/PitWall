<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:PitWallApp"
        x:Class="PitWallApp.MainWindow"
        Title="PitWall" Width="1440" Height="900" MinWidth="980" MinHeight="620">
  <Grid RowDefinitions="62,*,28">
    <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="22,0" ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image x:Name="LogoImage" Width="38" Height="38" Margin="0,0,11,0"
                 RenderOptions.BitmapInterpolationMode="HighQuality" />
          <TextBlock Text="Pit Wall" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock x:Name="VersionText" Classes="muted" FontSize="11" VerticalAlignment="Center"
                     Margin="8,1,0,0" />
          <Button x:Name="UpdateButton" Content="Update available" IsVisible="False" Margin="14,0,0,0"
                  Padding="10,3" FontSize="11" Background="#1F4D36" BorderBrush="#2F7A54" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock x:Name="SessionCountText" Text="No sessions loaded" Classes="muted" FontSize="11"
                     VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox x:Name="UnitsBox" Width="120" SelectedIndex="0">
            <ComboBoxItem>Metric</ComboBoxItem>
            <ComboBoxItem>Imperial</ComboBoxItem>
          </ComboBox>
          <Button x:Name="OpenButton" Content="Open data folder" />
          <Button x:Name="ImportButton" Content="Import…"
                  ToolTip.Tip="Import PitWall packages into the data folder" />
          <Button x:Name="SettingsButton" Content="⚙" FontSize="17" Padding="9,3"
                  ToolTip.Tip="Settings" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="338" MinWidth="220" MaxWidth="760" />
          <ColumnDefinition Width="5" />
          <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0">
          <Grid Margin="16,16,12,12" RowDefinitions="Auto,*">
            <StackPanel Margin="3,0,0,13">
              <TextBlock Text="SESSION LIBRARY" Classes="caption" FontSize="10" />
              <TextBlock x:Name="FolderText" Text="Choose a folder containing session JSON files" FontSize="10"
                         Foreground="#798693" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
            <TreeView x:Name="SessionTree" Grid.Row="1">
              <TreeView.ItemContainerTheme>
                <ControlTheme x:DataType="TreeViewItem" TargetType="TreeViewItem"
                              BasedOn="{StaticResource {x:Type TreeViewItem}}">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </ControlTheme>
              </TreeView.ItemContainerTheme>
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Background="Transparent">
                    <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                               FontWeight="{Binding Weight}" />
                    <TextBlock Classes="suffix" Classes.link="{Binding SuffixIsLink}" Text="{Binding Suffix}"
                               Foreground="{Binding EffectiveSuffixForeground}" FontWeight="{Binding Weight}"
                               Background="Transparent" />
                    <TextBlock Text="{Binding Tail}" Foreground="{Binding Foreground}"
                               FontWeight="{Binding Weight}" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Grid>
        </Border>

        <GridSplitter x:Name="Splitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      Background="#394857" />

        <Grid Grid.Column="2">
          <Grid x:Name="DataPanel" Margin="19,15,19,12" RowDefinitions="Auto,Auto,*">
            <Grid Margin="2,0,2,13" ColumnDefinitions="*,Auto">
              <TextBlock x:Name="TrackTitleText" Text="Select a session" FontSize="21" FontWeight="SemiBold"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="SetReferenceButton" Content="Use selected lap as reference" IsEnabled="False" />
                <Button x:Name="ClearReferenceButton" Content="Clear reference" IsEnabled="False" />
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,13" ColumnDefinitions="*,10,*,10,*,10,*">
              <Border Classes="panel">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="SESSION · LAP" Classes="caption" />
                    <TextBlock x:Name="PrimaryLapTypeText" Grid.Column="1" FontSize="9" FontWeight="Bold"
                               IsVisible="False" />
                  </Grid>
                  <TextBlock x:Name="PrimaryLapText" Text="—" FontSize="10" FontWeight="SemiBold"
                             TextWrapping="Wrap" Margin="0,5,0,0" />
                  <TextBlock x:Name="PrimaryLapDetailsText" FontSize="9" Classes="muted" TextWrapping="Wrap"
                             Margin="0,3,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="panel">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="REFERENCE · LAP" Classes="caption" />
                    <TextBlock x:Name="ReferenceLapTypeText" Grid.Column="1" FontSize="9" FontWeight="Bold"
                               IsVisible="False" />
                  </Grid>
                  <TextBlock x:Name="ReferenceLapText" Text="—" FontSize="10" FontWeight="SemiBold"
                             TextWrapping="Wrap" Margin="0,5,0,0" />
                  <TextBlock x:Name="ReferenceLapDetailsText" FontSize="9" Classes="muted" TextWrapping="Wrap"
                             Margin="0,3,0,0" Text="Right-click a lap to set reference" />
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Classes="panel">
                <StackPanel>
                  <TextBlock Text="LAP DELTA · A − B" Classes="caption" />
                  <TextBlock x:Name="LapDeltaText" Text="—" Classes="statValue" />
                </StackPanel>
              </Border>
              <Border Grid.Column="6" Classes="panel">
                <StackPanel>
                  <TextBlock Text="DISTANCE AT CURSOR" Classes="caption" />
                  <TextBlock x:Name="CursorDistanceText" Text="—" Classes="statValue" />
                </StackPanel>
              </Border>
            </Grid>
            <app:TraceView x:Name="Trace" Grid.Row="2" />
          </Grid>
          <app:TrackOverviewView x:Name="Overview" IsVisible="False" Margin="19,15,19,12" />
        </Grid>
      </Grid>

      <Grid x:Name="LoadingIndicator" IsVisible="False" IsHitTestVisible="False" Background="#9911171D">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#202A35"
                BorderBrush="#394857" BorderThickness="1" CornerRadius="12" Padding="34,28" MinWidth="420">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="LOADING TELEMETRY" FontSize="11" FontWeight="Bold" Foreground="#94A0AD"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="LoadingDetailText" FontSize="15" Foreground="#E8EDF2" MaxWidth="560"
                       TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,12,0,18" />
            <ProgressBar Width="350" Height="12" IsIndeterminate="True" Foreground="#39C3D8"
                         Background="#293542" BorderThickness="0" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" Text="Open a data folder to begin." FontSize="10" Classes="muted"
                 Margin="20,0" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>
