<Window x:Class="TrackTelemetryViewer.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#11171D" Foreground="#E8EDF2" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8EDF2"/>
            <Setter Property="Background" Value="#293542"/>
            <Setter Property="BorderBrush" Value="#394857"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#344554"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#E8EDF2"/>
            <Setter Property="Background" Value="#11171D"/>
            <Setter Property="BorderBrush" Value="#394857"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="#E8EDF2"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E8EDF2"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="InfoText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="Format" Foreground="#94A0AD" FontSize="11" Margin="0,16,0,4"/>
        <RadioButton x:Name="PitWallRadio" IsChecked="True" Checked="Format_Changed"
                     Content="PitWall package (.pitwall) – one zip with all session data and corrections"/>
        <RadioButton x:Name="XrkRadio" Checked="Format_Changed"
                     Content="AiM XRK (.xrk) – one file per session (best-effort conversion)"/>
        <TextBlock x:Name="XrkNote" Foreground="#94A0AD" FontSize="11" TextWrapping="Wrap" Margin="22,0,0,0"
                   Text="Converted from GPS, speed, G-forces and laps. Other Garmin channels are not included."/>
        <TextBlock x:Name="DestinationLabel" Text="Save to" Foreground="#94A0AD" FontSize="11" Margin="0,16,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DestinationBox"/>
            <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"/>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="ExportButton" Content="Export" Click="Export_Click" IsDefault="True"/>
            <Button Content="Cancel" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
